# ============================================================
# PillSync Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pillsync

# JWT Authentication
JWT_SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Application environment (development | production)
ENVIRONMENT=development

# ============================================================
# Twilio SMS Configuration
# ------------------------------------------------------------
# To enable REAL SMS delivery:
#   1. Sign up at https://console.twilio.com (free trial available)
#   2. Copy your Account SID from the Twilio Console dashboard
#   3. Copy your Auth Token from the Twilio Console dashboard
#   4. Get or buy a Twilio phone number (free trial number available)
#   5. Paste the values below and restart the server
#
# Leave all three BLANK to run in MOCK/SIMULATOR mode:
#   - Mock mode prints SMS content to the terminal only
#   - No real messages are sent in mock mode
# ============================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
